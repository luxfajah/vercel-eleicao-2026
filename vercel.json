{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/tse",
      "destination": "/api/tse.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
